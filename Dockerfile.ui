# Streamlit UI image.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY ui ./ui

RUN uv sync --frozen --no-dev

EXPOSE 8501

CMD ["uv", "run", "--no-sync", "streamlit", "run", "ui/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
