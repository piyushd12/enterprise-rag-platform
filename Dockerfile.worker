# Base image with Python 3.12
FROM python:3.12-slim

# Install uv (fast, reliable dependency manager)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# Copy project files
COPY pyproject.toml uv.lock README.md ./

# Deps first (cached until pyproject/uv.lock change), source after, so editing
# src/ doesn't reinstall every package.
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev --no-install-project

COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev

# Default command: run the Celery worker
CMD ["uv", "run", "--no-sync", "celery", "-A", "rag_app.queue.celery_app", "worker", "--loglevel=info"]
