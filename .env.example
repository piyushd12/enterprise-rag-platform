# =============================================================================
# RAG Application — Environment Variables
# Copy to .env and fill in your actual values
# =============================================================================

# --- LLM Providers ---
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here

# --- Observability ---
LANGSMITH_API_KEY=lsv2_your_langsmith_api_key_here
LANGSMITH_PROJECT=rag-app
LANGSMITH_TRACING=true
LOGFIRE_TOKEN=your_logfire_token_here

# --- Infrastructure ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
REDIS_URL=redis://localhost:6380/0

# --- Embedding Model ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- LLM Models ---
LLM_PRIMARY_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_MODEL=openrouter/free

# --- Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Caching ---
CACHE_TTL_ANSWERS=3600
CACHE_TTL_EMBEDDINGS=86400

# --- Guardrails ---
# Master switch for detection guards (structural ones are always on)
GUARDRAILS_ENABLED=true
# Weighted injection-phrase score that blocks a query (below it: flag)
GUARD_INJECTION_BLOCK_SCORE=1.0
# Minimum top reranker score for generation to run; "none" disables the floor
GUARD_RELEVANCE_MIN_SCORE=none
# drop | wrap -- retrieved chunks flagged as containing injection text
GUARD_FLAGGED_CHUNK_ACTION=drop
# mask | flag | drop -- chunks containing secrets at ingestion
GUARD_INGEST_SECRET_ACTION=mask
# Mask PII in answers (secrets are always masked)
GUARD_MASK_OUTPUT_PII=true
# Flag answers with missing or out-of-range [Source N] citations
GUARD_CITATION_CHECK=true
# Optional LLM groundedness judge (one extra LLM call per answer)
GUARD_GROUNDEDNESS_LLM=false
# Classifier-type checks: timeout, and open|closed on error/timeout
GUARD_CLASSIFIER_TIMEOUT_S=5.0
GUARD_CLASSIFIER_FAIL_MODE=open
