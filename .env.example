# =============================================================================
# RAG Application — Environment Variables
# Copy to .env and fill in your actual values
# =============================================================================

# --- LLM Providers ---
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here

# --- Observability ---
LANGSMITH_API_KEY=lsv2_your_langsmith_api_key_here
LANGSMITH_PROJECT=rag-app
LANGSMITH_TRACING=true
LOGFIRE_TOKEN=your_logfire_token_here

# --- Infrastructure ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
REDIS_URL=redis://localhost:6379/0

# --- Embedding Model ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- LLM Models ---
LLM_PRIMARY_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=nvidia/llama-3.1-nemotron-70b-instruct:free

# --- Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Caching ---
CACHE_TTL_ANSWERS=3600
CACHE_TTL_EMBEDDINGS=86400
